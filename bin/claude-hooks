#!/usr/bin/env bash
# Entry point for every hook in this marketplace: builds the named command on
# first use, caches it, and execs it.
#
#   claude-hooks astgrep-lint [files...]
#   claude-hooks bashguard    [commands...]
#   claude-hooks autofmt
#
# The build cache exists because `go run` relinks on every invocation, and these
# hooks fire on every Write, Edit and Bash call. It is keyed on the plugin's
# persistent data directory, which survives plugin updates.
set -euo pipefail

usage() {
  echo "usage: claude-hooks <astgrep-lint|bashguard|autofmt> [args...]" >&2
  exit 64
}

# stale reports whether the cached binary is missing or older than any Go source
# in the plugin, so an edited rule or command takes effect without a manual
# rebuild.
stale() {
  local bin="$1" root="$2"
  [[ -x "$bin" ]] || return 0
  [[ -n "$(find "$root" -name '*.go' -newer "$bin" -print -quit 2>/dev/null)" ]]
}

[[ $# -ge 1 ]] || usage
command_name="$1"
shift

case "$command_name" in
  astgrep-lint | bashguard | autofmt) ;;
  *) usage ;;
esac

root="${CLAUDE_PLUGIN_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}"
data="${CLAUDE_PLUGIN_DATA:-${XDG_CACHE_HOME:-$HOME/.cache}/claude-plugins}"
bin="${data}/bin/${command_name}"

# Fail open on a missing or broken toolchain: an unbuildable hook is an
# environment problem rather than a finding, and must not block the user's work.
# Hooks run in whatever environment Claude Code spawns, not inside an activated
# `nix develop` shell, so Go installed only in a flake devShell is absent here.
if stale "$bin" "$root"; then
  if ! command -v go >/dev/null 2>&1; then
    echo "${command_name}: 'go' not found on PATH; this hook is inactive for the session" >&2
    exit 0
  fi
  mkdir -p "$(dirname -- "$bin")"
  if ! (cd -- "$root" && go build -o "$bin" "./cmd/${command_name}") >&2; then
    echo "${command_name}: build failed; this hook is inactive for the session" >&2
    exit 0
  fi
fi

exec "$bin" "$@"
